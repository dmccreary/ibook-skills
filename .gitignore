site
.DS_Store
~$*
.cache
.vscode

# Python bytecode. Regenerated automatically on import, never source. These
# were once scoped to mcp-servers/** only, which let __pycache__ dirs under
# plugins/, scripts/, skills/, and src/ get committed.
__pycache__/
*.py[cod]

mcp-servers/**/*.egg-info/
mcp-servers/**/dist/
mcp-servers/**/build/
mcp-servers/**/.venv/
mcp-servers/**/venv/
.claude/activity-logs/
.claude/settings.local.json
.claude/worktrees/

# Per-turn tracking files used by the auto-commit-ibook-skills hooks.
# .claude-pending-commit.txt holds the commit message Claude writes during
# the turn; .claude-pending-files.txt holds the list of file paths Claude
# edited via Edit/Write/MultiEdit (populated by track-ibook-skills-edits.sh).
# Both are deleted by the Stop hook after a successful commit. Never commit
# either file.
.claude-pending-commit.txt
.claude-pending-files.txt

# skill-creator eval workspaces (<skill>-workspace/ beside each skill). They hold
# benchmark runs, per-run outputs with nested git repos, and Python virtualenvs,
# and can reach a gigabyte. Results worth keeping belong in the skill's evals/.
skills/*-workspace/
