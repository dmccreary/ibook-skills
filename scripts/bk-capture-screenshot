#!/bin/bash
# bk-capture-screenshot
#
# Capture a screenshot of a MicroSim using headless Chromium driven by Playwright.
# Can be run from within a MicroSim directory or by specifying a path.
#
# Usage:
#   cd /path/to/microsim && bk-capture-screenshot
#   bk-capture-screenshot /path/to/microsim
#   bk-capture-screenshot /path/to/microsim 5        # 5 second delay
#   bk-capture-screenshot /path/to/microsim 3 700    # 3 second delay, 700px height
#
# Arguments:
#   $1  MicroSim directory path (default: current directory)
#   $2  Delay in seconds for JS rendering (default: 3)
#   $3  Target image height in pixels (default: 600)
#       Tip: use the iframe height from the MicroSim's index.md file.
#
# Output:
#   Creates <microsim-name>.png in the MicroSim directory.
#
# Requirements:
#   - Python 3 with Playwright:  pip install playwright && playwright install chromium
#     (python3 on PATH is used; set BK_PYTHON to point at a different interpreter,
#     e.g. BK_PYTHON=/path/to/envs/mkdocs/bin/python3)
#   - Playwright's bundled Chromium, or Google Chrome as a fallback
#
# Screenshot approach — exact viewport:
#   The page is loaded in a viewport of exactly WINDOW_WIDTH x target height,
#   the same size as the iframe in index.md, and the viewport is captured as-is.
#   Playwright sets the viewport through the DevTools protocol before the page
#   loads, so `100vh`, window.innerHeight, and p5's windowHeight all equal the
#   target height from the first frame.
#
#   Earlier versions ran `chrome --headless=new --screenshot --window-size=W,H`.
#   On macOS that starts the page ~87px shorter than --window-size and only
#   resizes at capture time, so the script rendered tall (H + 200) and cropped
#   with PIL. Any layout sized with `height: 100vh` (including the standard
#   vis-network template) then laid out for the taller window: the graph was
#   centered too low and the bottom node row and legend fell below the crop.
#
# Local HTTP server:
#   The page is served from a temporary server on 127.0.0.1 rather than opened
#   as file://, because Playwright's Chromium blocks fetch() of file:// URLs
#   (so MicroSims that load data.json, like the vis-network template, came up
#   empty). The server root is the git repository containing the MicroSim
#   (or two levels above it outside git), so relative links such as
#   ../../img/logo.png resolve the same way they do under `mkdocs serve`.
#   The server stops when the capture finishes.
#
# WebGL support:
#   Chromium is launched with --use-gl=angle --use-angle=swiftshader
#   --enable-unsafe-swiftshader for software WebGL rendering in headless mode.
#   This is required for MicroSims that use p5.js WEBGL mode (3D rendering);
#   without it WEBGL canvases render as blank white rectangles.
#
#   WEBGL MicroSims that load external fonts via loadFont() from a CDN
#   may need a longer delay (e.g., 10 seconds) to allow the font to
#   download before the screenshot is captured.

# Colors for output
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
RED='\033[0;31m'
NC='\033[0m' # No Color

# Default delay in seconds (time to wait for JavaScript to load)
DELAY_SECONDS=3

# Default window dimensions
WINDOW_WIDTH=800
WINDOW_HEIGHT=600

# Parse arguments
if [ $# -eq 0 ]; then
    # No argument provided - use current directory
    MICROSIM_DIR="$(pwd)"
elif [ $# -eq 1 ]; then
    # One argument - use it as directory
    MICROSIM_DIR="$1"
elif [ $# -eq 2 ]; then
    # Two arguments - directory and delay
    MICROSIM_DIR="$1"
    DELAY_SECONDS="$2"
else
    # Three arguments - directory, delay, and height
    MICROSIM_DIR="$1"
    DELAY_SECONDS="$2"
    WINDOW_HEIGHT="$3"
fi

# The viewport is exactly the target height (see "exact viewport" above).
TARGET_HEIGHT=$WINDOW_HEIGHT

# Validate directory exists
if [ ! -d "$MICROSIM_DIR" ]; then
    echo -e "${RED}Error: Directory does not exist: $MICROSIM_DIR${NC}"
    exit 1
fi

# Validate main.html exists
if [ ! -f "$MICROSIM_DIR/main.html" ]; then
    echo -e "${RED}Error: main.html not found in $MICROSIM_DIR${NC}"
    echo -e "${YELLOW}This script must be run from a MicroSim directory or provided a path to one.${NC}"
    echo ""
    echo "A MicroSim directory should contain:"
    echo "  - main.html (the simulation file)"
    echo "  - index.md (documentation)"
    echo "  - metadata.json (metadata)"
    exit 1
fi

# Extract MicroSim name from directory path
MICROSIM_NAME=$(basename "$MICROSIM_DIR")

# Construct paths
OUTPUT_IMAGE="$MICROSIM_DIR/${MICROSIM_NAME}.png"
ABSOLUTE_DIR=$(cd "$MICROSIM_DIR" && pwd -P)
ABSOLUTE_PATH="$ABSOLUTE_DIR/main.html"

# Serve from the enclosing git repo so ../../ links resolve; outside git,
# fall back to two levels up (docs/ for the usual docs/sims/<name> layout).
SERVE_ROOT=$(git -C "$ABSOLUTE_DIR" rev-parse --show-toplevel 2>/dev/null) \
    || SERVE_ROOT=$(cd "$ABSOLUTE_DIR/../.." && pwd -P)

# Find a Python that has Playwright
PYTHON="${BK_PYTHON:-python3}"
if ! "$PYTHON" -c "import playwright.sync_api" &> /dev/null; then
    echo -e "${RED}Error: Playwright for Python not found (interpreter: $PYTHON).${NC}"
    echo "Install it with:"
    echo "  pip install playwright && playwright install chromium"
    echo "or activate the conda env that has it (e.g. conda activate mkdocs),"
    echo "or set BK_PYTHON to a python3 that can import playwright."
    exit 1
fi

echo -e "${BLUE}════════════════════════════════════════════════════════════════${NC}"
echo -e "${GREEN}MicroSim Screenshot Capture${NC}"
echo -e "${BLUE}════════════════════════════════════════════════════════════════${NC}"
echo ""
echo -e "📸 Capturing screenshot of MicroSim: ${YELLOW}$MICROSIM_NAME${NC}"
echo -e "   Source: ${BLUE}$ABSOLUTE_PATH${NC}"
echo -e "   Output: ${BLUE}$OUTPUT_IMAGE${NC}"
echo -e "   Size:   ${YELLOW}${WINDOW_WIDTH}x${TARGET_HEIGHT}${NC}"
echo -e "   Delay:  ${YELLOW}${DELAY_SECONDS} seconds${NC} (waiting for JavaScript to load)"
echo ""

# Capture screenshot with Playwright
# Chromium flags:
#   --use-gl=angle --use-angle=swiftshader --enable-unsafe-swiftshader:
#       Software WebGL rendering (needed for WEBGL canvases)
#   --hide-scrollbars: Remove scrollbars from capture
#   --disable-web-security: Allow loading external resources (CDNs)
"$PYTHON" - "$SERVE_ROOT" "$ABSOLUTE_DIR" "$OUTPUT_IMAGE" "$WINDOW_WIDTH" "$TARGET_HEIGHT" "$DELAY_SECONDS" <<'PY'
import functools, os, sys, threading
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import quote
from playwright.sync_api import sync_playwright, Error as PlaywrightError, TimeoutError as PlaywrightTimeout

serve_root, sim_dir, output, width, height, delay = sys.argv[1:7]
viewport = {"width": int(width), "height": int(height)}
args = [
    "--use-gl=angle",
    "--use-angle=swiftshader",
    "--enable-unsafe-swiftshader",
    "--hide-scrollbars",
    "--disable-web-security",
]

class QuietHandler(SimpleHTTPRequestHandler):
    def log_message(self, *a):
        pass

server = ThreadingHTTPServer(("127.0.0.1", 0), functools.partial(QuietHandler, directory=serve_root))
threading.Thread(target=server.serve_forever, daemon=True).start()
rel = Path(os.path.relpath(sim_dir, serve_root)).as_posix()
url = f"http://127.0.0.1:{server.server_port}/{quote(rel)}/main.html"

with sync_playwright() as p:
    try:
        browser = p.chromium.launch(args=args)
    except PlaywrightError:
        # Bundled Chromium not installed; use Google Chrome if present
        browser = p.chromium.launch(channel="chrome", args=args)
    page = browser.new_page(viewport=viewport, device_scale_factor=1)
    errors = []
    page.on("pageerror", lambda e: errors.append(str(e)))
    try:
        page.goto(url, wait_until="load")
    except PlaywrightTimeout:
        print("   Warning: page did not finish loading in 30s; capturing anyway")
    page.wait_for_timeout(float(delay) * 1000)
    page.screenshot(path=output)
    browser.close()
server.shutdown()

for e in errors[:3]:
    print(f"   JS error: {e.splitlines()[0]}")
PY
CAPTURE_STATUS=$?

# Verify screenshot was created
if [ $CAPTURE_STATUS -eq 0 ] && [ -f "$OUTPUT_IMAGE" ]; then
    SIZE=$(ls -lh "$OUTPUT_IMAGE" | awk '{print $5}')
    echo -e "${GREEN}✅ Screenshot captured successfully!${NC}"
    echo -e "   File: ${YELLOW}$OUTPUT_IMAGE${NC} (${SIZE})"
    echo ""
    echo -e "${BLUE}════════════════════════════════════════════════════════════════${NC}"
else
    echo -e "${RED}❌ Failed to capture screenshot${NC}"
    echo "Playwright/Chromium may have encountered an error (see output above)."
    exit 1
fi
