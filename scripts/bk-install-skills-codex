#!/usr/bin/env bash
# DEPRECATED — kept so existing invocations keep working.
#
# The three per-agent installers were consolidated into bk-install-skills,
# which installs into every agent present on this machine. Installing one
# agent at a time was the reason the other agents drifted out of date.
#
# Use: bk-install-skills             (all agents)
#      bk-install-skills --only codex
set -euo pipefail
printf '\033[1;33mbk-install-skills-codex is deprecated; running: bk-install-skills --only codex\033[0m\n' >&2
exec "$(dirname "${BASH_SOURCE[0]}")/bk-install-skills" --only codex "$@"
