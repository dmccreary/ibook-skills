#!/usr/bin/env bash
# bk-check-mascot-rules
#
# Enforces that the mascot placement rules live in exactly one place.
#
# The canonical file is:
#   $BK_HOME/skills/book-installer/references/mascot-placement-rules.md
#
# Every other skill must REFERENCE that file, never restate its tables,
# counts, or per-pose rules. This check fails if a restatement reappears,
# and if a rendered CONTENT-GENERATION-GUIDE.md block has been hand-edited.
#
# Exit 0 clean, 1 if any violation found.

set -uo pipefail

GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'; BLUE='\033[0;34m'; NC='\033[0m'

REPO_ROOT="${BK_HOME:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
CANONICAL="skills/book-installer/references/mascot-placement-rules.md"
RENDER="skills/book-installer/scripts/render-mascot-guide.py"

cd "$REPO_ROOT" || { echo "Cannot cd to $REPO_ROOT"; exit 1; }

echo -e "${BLUE}════════════════════════════════════════════════════════════════${NC}"
echo -e "${GREEN}Checking mascot placement rules are single-sourced${NC}"
echo -e "${BLUE}════════════════════════════════════════════════════════════════${NC}"
echo -e "Canonical: ${YELLOW}$CANONICAL${NC}"
echo ""

violations=0

if [ ! -f "$CANONICAL" ]; then
    echo -e "${RED}✗${NC} Canonical file is missing: $CANONICAL"
    exit 1
fi

# Files that are allowed to contain the rules verbatim:
#   - the canonical file itself
#   - skills/archived/ (frozen historical copies, never loaded)
#   - the renderer and this checker (they name the patterns they enforce)
is_exempt() {
    case "$1" in
        "$CANONICAL") return 0 ;;
        skills/archived/*) return 0 ;;
        "$RENDER") return 0 ;;
        # Teacher-facing prose in a generated deliverable cannot be a pointer —
        # it explains the mascot to humans reading the instructor's guide. It is
        # marked "derived" in the file and must be updated when canonical
        # counts change, but it is not a competing source of truth.
        skills/book-installer/references/instructors-guide.md) return 0 ;;
        scripts/bk-check-mascot-rules) return 0 ;;
        skills/book-installer/scripts/validate-chapter-mascots.py) return 0 ;;
    esac
    return 1
}

# Each rule: <label>|<extended-regex>
# Patterns are deliberately narrow to avoid flagging a pointer such as
# "see mascot-placement-rules.md for the per-chapter counts".
RULES=(
"wrong admonition class 'mascot-encouraging' (canonical class is 'mascot-encourage')|mascot-encouraging"
"restated placement table|^\\|[[:space:]]*Context[[:space:]]*\\|[[:space:]]*Admonition"
"restated per-chapter count|(more than|maximum of|Maximum|no more than|at most)[[:space:]]+[0-9]+([[:space:]]*[-–][[:space:]]*[0-9]+)?[[:space:]]+(times|mascot admonitions)"
"restated total cap|(limit is|ceiling of|≤[[:space:]]*)[0-9]+[[:space:]]*(mascot )?admonitions"
"restated back-to-back rule as a standalone rule|^[[:space:]]*[-*][[:space:]]+Never place two mascot admonitions back-to-back"
"restated frequency range|[0-9]+[[:space:]]*[-–][[:space:]]*[0-9]+[[:space:]]+(times|admonitions|mascot admonitions)[[:space:]]+(per chapter|in (a|any|each) chapter)"
)

echo -e "${BLUE}Scanning skills/ for restated rules...${NC}"
for rule in "${RULES[@]}"; do
    label="${rule%%|*}"
    pattern="${rule#*|}"
    while IFS=: read -r file line text; do
        [ -z "$file" ] && continue
        if is_exempt "$file"; then continue; fi
        echo -e "${RED}✗${NC} $label"
        echo -e "    ${YELLOW}$file:$line${NC}  ${text:0:90}"
        violations=$((violations + 1))
    done < <(grep -rEn --include="*.md" --include="*.py" "$pattern" skills/ 2>/dev/null)
done

if [ "$violations" -eq 0 ]; then
    echo -e "${GREEN}✓${NC} No restated rules found outside the canonical file"
fi
echo ""

# Verify any rendered book guide still matches the canonical rules.
echo -e "${BLUE}Checking rendered CONTENT-GENERATION-GUIDE.md...${NC}"
if [ -f CONTENT-GENERATION-GUIDE.md ] && grep -q "BEGIN mascot-placement-rules" CONTENT-GENERATION-GUIDE.md; then
    if python3 "$RENDER" --check >/dev/null 2>&1; then
        echo -e "${GREEN}✓${NC} Rendered block matches the canonical rules"
    else
        echo -e "${RED}✗${NC} CONTENT-GENERATION-GUIDE.md has drifted from $CANONICAL"
        echo -e "    Re-render with: ${YELLOW}python3 $RENDER${NC}"
        violations=$((violations + 1))
    fi
else
    echo -e "${YELLOW}⚠${NC}  No rendered mascot block in CONTENT-GENERATION-GUIDE.md (skipping)"
fi

echo ""
echo -e "${BLUE}════════════════════════════════════════════════════════════════${NC}"
if [ "$violations" -eq 0 ]; then
    echo -e "${GREEN}Done — mascot placement rules are single-sourced.${NC}"
    exit 0
fi
echo -e "${RED}Found $violations violation(s).${NC}"
echo -e "Replace each restatement with a pointer to ${YELLOW}$CANONICAL${NC}"
exit 1
